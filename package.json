{
  "name": "pgobject",
  "version": "3.0.0",
  "description": "Lightweight ORM for PostgreSQL and MySQL: models as classes, partial updates, safe transactions with connection pools, TypeScript types, ES modules and CommonJS",
  "main": "PgObject.js",
  "types": "./PgObject.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./PgObject.d.ts",
        "default": "./PgObject.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "PgObject.js",
    "__IPgObjectQuery.js",
    "__PgQuery.js",
    "__MySqlQuery.js",
    "index.mjs",
    "PgObject.d.ts",
    "index.d.mts"
  ],
  "scripts": {
    "test": "jest && node --test esm.test.mjs && tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gyk088/pgObject"
  },
  "keywords": [
    "orm",
    "postgresql",
    "postgres",
    "pg",
    "mysql",
    "mysql2",
    "sql",
    "database",
    "model",
    "active-record",
    "transaction",
    "typescript",
    "esm",
    "lightweight",
    "simple-orm",
    "node-orm"
  ],
  "author": "Andrey Zhuk <gyk088@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/gyk088/pgObject",
  "bugs": {
    "url": "https://github.com/gyk088/pgObject/issues"
  },
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "mysql2": "^3.24.6",
    "pg": "^8.8.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "jest": "^29.2.1",
    "sqlstring": "^2.3.3",
    "typescript": "^5.9.3"
  }
}
